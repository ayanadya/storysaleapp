# Copy to .env and fill in. .env is gitignored.

# Instagram burner account used by the scraper.
IG_USERNAME=your_burner_handle
IG_PASSWORD=your_burner_password

# Optional path overrides (defaults match the code).
STORYSALE_SESSION_PATH=secrets/session-burner
STORYSALE_DB_PATH=data/storysale.db
STORYSALE_THUMB_DIR=data/thumbs
